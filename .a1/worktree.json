      "preflight",
      "--repo",
      "{primary}",
      "--path",
      "{worktree}",
      "--approved-snapshot",
      "{snapshot}"
    ],
    "execute": [
      "node",
      "tools/worktree/runtime-removal-adapter.mjs",
      "execute",
      "--repo",
      "{primary}",
      "--path",
      "{worktree}",
      "--approved-snapshot",
      "{snapshot}"
