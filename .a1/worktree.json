    "preflight-complete",
    "--repo",
    "{primary}",
    "--path",
    "{worktree}",
    "--approved-snapshot",
    "{snapshot}"
  ],
  "cleanup": [
    "node",
    "tools/worktree/runtime-removal-adapter.mjs",
