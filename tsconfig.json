{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["packages/*/src/**/*.ts", "tools/embedded/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", "**/test", "**/build", "**/dist", "**/third_party", ".xrbuild", ".artifacts", "embedded"]
}
